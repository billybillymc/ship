# FleetGraph Agent — Environment Variables
# Copy this to .env and fill in your keys

# LangSmith tracing (required for Step 14)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_xxxxx
LANGCHAIN_PROJECT=fleetgraph

# Google AI / Gemini (required for reasoning)
GOOGLE_AI_API_KEY=AIzaSyxxxxx

# Ship API connection
SHIP_API_URL=http://localhost:3000
SHIP_WS_URL=ws://localhost:3000
AGENT_SERVICE_TOKEN=ship_fleetgraph_dev_token_do_not_use_in_prod

# Agent server
AGENT_PORT=3001

# Workspace ID (get from: SELECT id FROM workspaces LIMIT 1)
WORKSPACE_ID=
